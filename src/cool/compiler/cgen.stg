sequence(e) ::= "<e; separator=\"\n\">"
sequenceSpaced(e) ::= "<e; separator=\"\n\n\">"

program(data, text, classes, intTag, stringTag, boolTag) ::= <<
.data
    .align 2
    .globl class_nameTab
    .globl <classes; separator="_protObj\n\t.globl ">_protObj
    .globl _int_tag
    .globl _string_tag
    .globl _bool_tag
_int_tag:
    .word <intTag>
_string_tag:
    .word <stringTag>
_bool_tag:
    .word <boolTag>
<data>
heap_start:
    .word 0
.text
<text>
>>

classNameTable(e) ::= <<
class_nameTab:
    .word <e; separator="\n\t.word ">
>>

dispTable(className, methods) ::= <<
<className>_dispTab:
    .word <methods; separator="\n\t.word ">
>>

objectTable(content) ::= <<
class_objTab:
<content; separator="\n">
>>

objectTableEntry(className) ::= <<
    .word <className>_protObj
    .word <className>_init
>>
string_literal(value, numWords, lengthRef, label, tag) ::= <<
<label>:
    .word <tag>
    .word <numWords>                # size in words
    .word String_dispTab
    .word <lengthRef>       # string length
    .asciiz "<value>"
    .align 2                # 2^2 alignment = 32 bits
>>

int_literal(value, label, tag) ::= <<
<label>:
    .word <tag>
    .word 4
    .word Int_dispTab
    .word <value>
>>

bool_literal(value, label, tag) ::= <<
<label>:
    .word <tag>
    .word 4
    .word Bool_dispTab
    .word <value>
>>

instanceInit(class, baseClass, initializations) ::= <<
<class>_init:
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<if(baseClass)>
    jal <baseClass>_init
<endif>
<initializations>
    move $a0 $s0
    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>

methodCall(actualParams, dispatchExpr, dispatchLabel, dispatch, filename, line) ::= <<
<actualParams>
    move $a0 $s0
<dispatchExpr>
    bnez $a0 dispatch<dispatchLabel>
    la $a0 <filename>
    li $t1 <line>
    jal _dispatch_abort
dispatch<dispatchLabel>:
<dispatch>
>>

pushActualParam(expr) ::= <<
<expr>
    sw $a0 0($sp)
    addiu $sp $sp -4
>>

dispatch(methodOffset, staticType) ::= <<
<if(staticType)>
    la $t1 <staticType>_dispTab
<else>
    lw $t1 8($a0)                       # offset of the disp table is (self +) 8
<endif>
    lw $t1 <methodOffset>($t1)
    jalr $t1
>>

literal(value) ::= <<
	li $a0 <value>
>>

id(base, offset, isSelf) ::= <<
<if(isSelf)>
    move $a0 $s0
<else>
    lw $a0 <offset>(<base>)
<endif>
>>

arithm(e1, e2, op) ::= <<
<e1>
    lw $t1 12($a0)
	sw $t1 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
	lw $t2 12($a0)
	<op> $t1 $t1 $t2
	addiu $sp $sp 4
	la $a0 Int_protObj

	sw $t1 0($sp)
	addiu $sp $sp -4
	jal Object.copy
	lw $t1 4($sp)
	addiu $sp $sp 4
    sw $t1 12($a0)
>>

genericProtObj(name, tag) ::= <<
<name>_protObj:
    .word <tag>
    .word 3
    .word <name>_dispTab
>>

intAndBoolProtObj(name, tag) ::= <<
<name>_protObj:
    .word <tag>
    .word 4
    .word <name>_dispTab
    .word 0
>>

stringProtObj(tag, lengthTag) ::= <<
String_protObj:
    .word <tag>
    .word 5
    .word String_dispTab
    .word <lengthTag>
    .asciiz ""
    .align 2
>>

protObj(className, tag, size, members, isEmpty) ::= <<
<className>_protObj:
    .word <tag>
    .word <size>
    .word <className>_dispTab
    <if(!isEmpty)>.word <members; separator="\n.word "><endif>
>>

methodDefinition(className, methodName, body, freeStackSize) ::= <<
<className>.<methodName>:
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<body>
    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp <freeStackSize>
    jr $ra
>>

loadInstance(e) ::= <<
    la $a0 <e>
>>

assign(basePtr, offset, e) ::= <<
<e>
    sw $a0 <offset>(<basePtr>)
>>

classMemberInit(offset, e) ::= <<
<e>
    sw $a0 <offset>($s0)
>>

uminus(e) ::= <<
<e>
    lw $t1 12($a0)
    neg $t1 $t1
    sw $t1 12($a0)
>>

newObject(type) ::= <<
    la $a0 <type>_protObj
    jal Object.copy
    jal <type>_init
>>

newSelfType() ::= <<
    lw $t1 0($s0)
    la $t7 class_objTab
    sll $t1 $t1 3
    addu $t7 $t1 $t7
    lw $a0 0($t7)          # _protObj
    sw $t7 0($sp)
    addiu $sp $sp -4
    jal Object.copy
    lw $t7 4($sp)
    addiu $sp $sp 4
    lw $t7 4($t7)          # _init
    jalr $t7
>>

not(expr, trueLabel, falseLabel, notLabel) ::= <<
<expr>
    lw $t1 12($a0)          # bool slot
    la $a0 <trueLabel>
    beqz $t1 not_<notLabel>
    la $a0 <falseLabel>
not_<notLabel>:
>>

isvoid(expr, trueLabel, falseLabel, label) ::= <<
<expr>
    move $t1 $a0
    la $a0 <trueLabel>
    beqz $t1 isvoid_<label>
    la $a0 <falseLabel>
isvoid_<label>:
>>

lessOrMaybeEqual(e1, e2, trueLabel, falseLabel, label, op) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4
<e2>
    lw $t2 12($a0)
    lw $t1 4($sp)
    lw $t1 12($t1)
    addiu $sp $sp 4

    la $a0 <trueLabel>
    <op> $t1 $t2 less_<label>
    la $a0 <falseLabel>
less_<label>:
>>

equal(e1, e2, trueLabel, falseLabel, label) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4
<e2>
    move $t2 $a0
    lw $t1 4($sp)
    addiu $sp $sp 4

    la $a0 <trueLabel>
    beq $t1 $t2 equals<label>

    la $a1 <falseLabel>
    jal equality_test
equals<label>:
>>

loadDefaultValue(instance) ::= <<
    la $a0 <instance>
>>

initializeLocalVar(basePtr, offset, initCode) ::= <<
<initCode>
    sw $a0 <offset>(<basePtr>)
>>

let(localVars, body, freeStackSize) ::= <<
    addiu $sp $sp -<freeStackSize>
<localVars; separator="\n">
<body>
    addiu $sp $sp <freeStackSize>
>>

iff(cond, thenBranch, elseBranch, label) ::= <<
<cond>
    lw $t1 12($a0)
    beqz $t1 elseBranch<label>
<thenBranch>
    b end<label>
elseBranch<label>:
<elseBranch>
end<label>:
>>

while(cond, body, label) ::= <<
startWhile<label>:
<cond>
    lw $t1 12($a0)
    beqz $t1 endWhile<label>
<body>
    b startWhile<label>
endWhile<label>:
    li $a0 0
>>

case(expr, branches, label, filename, line) ::= <<
    addiu $sp $sp -4  # allocate one word on stack for expr result
<expr>
    bnez $a0 caseStart<label>
    la $a0 <filename>
    li $t1 <line>
    jal _case_abort2
caseStart<label>:
    lw $t1 0($a0)           # get class tag from instance
<branches; separator="\n">
caseEnd<label>:
>>

caseBranch(body, start, end, label, caseEndLabel) ::= <<
    blt $t1     <start> fail<label>
    bgt $t1     <end>   fail<label>
<body>
    b caseEnd<caseEndLabel>
fail<label>:
>>
