sequence(e) ::= "<e; separator=\"\n\">"
sequenceSpaced(e) ::= "<e; separator=\"\n\n\">"

program(data, text, textMain) ::= <<
.data
<data>

.text
<text>

main:
<textMain>
	li $v0, 10
	syscall		#exit
>>

prologue() ::= <<
_int_tag:           # tags used for equality check by the Cool runtime
    .word 2
_string_tag:
    .word 3
_bool_tag:
    .word 4

    .data
    .align  2
    .globl  class_nameTab
    .globl  Int_protObj
    .globl  String_protObj
    .globl  bool_const0
    .globl  bool_const1
    .globl  Main_protObj
    .globl  _int_tag
    .globl  _string_tag
    .globl  _bool_tag
_int_tag:
    .word   2
_string_tag:
    .word   3
_bool_tag:
    .word   4
str_const0:
    .word   3
    .word   5
    .word   String_dispTab
    .word   int_const0
    .asciiz ""
    .align  2
>>

classNameTable(e) ::= <<
class_nameTab:
    .word <e; separator="\n\t.word ">
>>

string_literal(value, numWords, lengthRef, label) ::= <<
<label>:
    .word 3
    .word <numWords>                # size in words
    .word Sring_dispTab
    .word <lengthRef>       # string length
    .asciiz "<value>"
    .align 2                # 2^2 alignment = 32 bits
>>

int_literal(value, label) ::= <<
<label>:
    .word 2
    .word 4
    .word Int_dispTab
    .word <value>
>>

bool_literal(value, label) ::= <<
<label>:
    .word 4
    .word 4
    .word Bool_dispTab
    .word <value>
>>

instanceInit(class, baseClass, initializations) ::= <<
<class>_init:
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
    jal <baseClass>_init
<initializations>
    move $a0 $s0
    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>

method_call(dispatch_label, filename, line) ::= <<
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<load_actual_params>
    move $a0 $s0
    bnez $a0 <dispatch_label>
    la $a0 <filename>
    li $t1 <line>
    jal _dispatch_abort
>>

push_actual_param(instance_address) ::= <<
    la $a0 <instance_address>
    sw $a0 0($sp)
    addiu $sp $sp -4
>>

dispatch(method_offset, unique_num) ::= <<
dispatch<unique_num>:
    lw $t1 8($a0)                       # offset of the disp table is (self +) 8
    lw $t1 <method_offset>($t1)
    jalr $t1

    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>





literal(value) ::= <<
	li $a0 <value>
>>

uMinus(value) ::= <<
<value>
    neg $a0 $a0         #endof unary minus
>>

plus(e1, e2, dStr) ::= <<
<e1>
	sw $a0 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
	add $a0 $t1 $a0
	addiu $sp $sp 4		<if(dStr)># <dStr><else><endif>
>>

arithm(e1, e2, dStr, op) ::= <<
<e1>
	sw $a0 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
	<op> $a0 $t1 $a0
	addiu $sp $sp 4		<if(dStr)># <dStr><else><endif>
>>

rel(e1, e2, dStr, jump, uniqueNum) ::= <<
<e1>
	sw $a0 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
<jump> $t1 $a0 true
false<uniqueNum>:
    li $a0 1
    b end<uniqueNum>
true<uniqueNum>:
    li $a0 0
end<uniqueNum>  <if(dStr)># <dStr><else><endif>
>>

cond(e1, e2, e3, dStr, uniqueNum) ::= <<
<e1>
    beqz $a0 else_branch
then_branch<uniqueNum>:
    <e2>
    b end_if<uniqueNum>
else_branch<uniqueNum>:
    <e3>
end_if<uniqueNum>:  <if(dStr)># <dStr><else><endif>
>>

singleParam(e1) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4

>>

call(e, dStr) ::= <<
    sw $fp 0($sp)
    addiu $sp $sp -4
<e>
    jal f <if(dStr)># <dStr><else><endif>
>>





f_def(e, dStr) ::= <<
    move $fp $sp
    sw $ra 0($sp)
    addiu $sp $sp -4
<e>                     # Generate code for the body
    lw ra 4($sp)
    addiu $sp $sp offset
    lw $fp 0($sp)
    jr $ra

>>

f_call() ::= <<
    sw $fp 0($sp)       # Build the precall sequence
    addiu $sp $sp -4
<en>
    sw $a0 0($sp)
    addiu $sp $sp -4
<en-1>
    ...
jal f
>>
