sequence(e) ::= "<e; separator=\"\n\">"
sequenceSpaced(e) ::= "<e; separator=\"\n\n\">"

program(data, text, classes, intTag, stringTag, boolTag) ::= <<
.data
    .align 2
    .globl class_nameTab
    .globl <classes; separator="_protObj\n\t.globl ">_protObj
    .globl _int_tag
    .globl _string_tag
    .globl _bool_tag
_int_tag:
    .word <intTag>
_string_tag:
    .word <stringTag>
_bool_tag:
    .word <boolTag>
<data>
heap_start:
    .word 0
.text
<text>
>>

classNameTable(e) ::= <<
class_nameTab:
    .word <e; separator="\n\t.word ">
>>

dispTable(className, methods) ::= <<
<className>_dispTab:
    .word <methods; separator="\n\t.word ">
>>

objectTable(content) ::= <<
class_objTab:
<content; separator="\n">
>>

objectTableEntry(className) ::= <<
    .word <className>_protObj
    .word <className>_init
>>
string_literal(value, numWords, lengthRef, label, tag) ::= <<
<label>:
    .word <tag>
    .word <numWords>                # size in words
    .word String_dispTab
    .word <lengthRef>       # string length
    .asciiz "<value>"
    .align 2                # 2^2 alignment = 32 bits
>>

int_literal(value, label, tag) ::= <<
<label>:
    .word <tag>
    .word 4
    .word Int_dispTab
    .word <value>
>>

bool_literal(value, label, tag) ::= <<
<label>:
    .word <tag>
    .word 4
    .word Bool_dispTab
    .word <value>
>>

instanceInit(class, baseClass, initializations) ::= <<
<class>_init:
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<if(baseClass)>
    jal <baseClass>_init
<endif>
<initializations>
    move $a0 $s0
    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>

method_call(dispatch_label, filename, line) ::= << # TODO
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<load_actual_params>
    move $a0 $s0
    bnez $a0 <dispatch_label>
    la $a0 <filename>
    li $t1 <line>
    jal _dispatch_abort
>>

push_actual_param(instance_address) ::= <<
    la $a0 <instance_address>
    sw $a0 0($sp)
    addiu $sp $sp -4
>>

dispatch(method_offset, unique_num) ::= <<
dispatch<unique_num>:
    lw $t1 8($a0)                       # offset of the disp table is (self +) 8
    lw $t1 <method_offset>($t1)
    jalr $t1

    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>

literal(value) ::= <<
	li $a0 <value>
>>

arithm(e1, e2, op) ::= <<
<e1>
    lw $t1 12($a0)
	sw $t1 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
	lw $t2 12($a0)
	<op> $t1 $t1 $t2
	addiu $sp $sp 4
	la $a0 Int_protObj
    jal Object.copy
    sw $t1 12($a0)
>>

rel(e1, e2, dStr, jump, uniqueNum) ::= <<
<e1>
	sw $a0 0($sp)
	addiu $sp $sp -4
<e2>
	lw $t1 4($sp)
<jump> $t1 $a0 true
false<uniqueNum>:
    li $a0 1
    b end<uniqueNum>
true<uniqueNum>:
    li $a0 0
end<uniqueNum>  <if(dStr)># <dStr><else><endif>
>>

cond(e1, e2, e3, dStr, uniqueNum) ::= <<
<e1>
    beqz $a0 else_branch
then_branch<uniqueNum>:
    <e2>
    b end_if<uniqueNum>
else_branch<uniqueNum>:
    <e3>
end_if<uniqueNum>:  <if(dStr)># <dStr><else><endif>
>>

singleParam(e1) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4

>>

call(e, dStr) ::= <<
    sw $fp 0($sp)
    addiu $sp $sp -4
<e>
    jal f <if(dStr)># <dStr><else><endif>
>>





f_def(e, dStr) ::= <<
    move $fp $sp
    sw $ra 0($sp)
    addiu $sp $sp -4
<e>                     # Generate code for the body
    lw ra 4($sp)
    addiu $sp $sp offset
    lw $fp 0($sp)
    jr $ra

>>

f_call() ::= <<
    sw $fp 0($sp)       # Build the precall sequence
    addiu $sp $sp -4
<en>
    sw $a0 0($sp)
    addiu $sp $sp -4
<en-1>
    ...
jal f
>>

genericProtObj(name, tag) ::= <<
<name>_protObj:
    .word <tag>
    .word 3
    .word <name>_dispTab
>>

intAndBoolProtObj(name, tag) ::= <<
<name>_protObj:
    .word <tag>
    .word 4
    .word <name>_dispTab
    .word 0
>>

stringProtObj(tag, lengthTag) ::= <<
String_protObj:
    .word <tag>
    .word 5
    .word String_dispTab
    .word <lengthTag>
    .asciiz ""
    .align 2
>>

protObj(className, tag, size, members, isEmpty) ::= <<
<className>_protObj:
    .word <tag>
    .word <size>
    .word <className>_dispTab
    <if(!isEmpty)>.word <members; separator="\n\t.word"><endif>
>>

methodDefinition(className, methodName, body) ::= <<
<className>.<methodName>:
    addiu $sp $sp -12
    sw $fp 12($sp)
    sw $s0 8($sp)
    sw $ra 4($sp)
    addiu $fp $sp 4
    move $s0 $a0
<body>
    move $a0 $s0
    lw $fp 12($sp)
    lw $s0 8($sp)
    lw $ra 4($sp)
    addiu $sp $sp 12
    jr $ra
>>

loadInstance(e) ::= <<
    la $a0 <e>
>>

assign(offset, e) ::= <<
<e>
    sw $a0 <offset>($fp)
>>

classMemberInit(offset, e) ::= <<
<e>
    sw $a0 <offset>($s0)
>>

uminus(e) ::= <<
<e>
    lw $t1 12($a0)
    neg $t1 $t1
    sw $t1 12$(a0)
>>

newObject(type) ::= <<
    la $a0 <type>_protObj
    jal Object.copy
    jal <type>_init
>>

newSelfType() ::= <<
    lw $t1 0($s0)
    la $t7 class_objTab
    sll $t1 $t1 3
    addu $t7 $t1 $t7
    lw $a0 0($t7)          # _protObj
    sw $t7 0($sp)
    addiu $sp $sp -4
    jal Object.copy
    lw $t7 4($sp)
    addiu $sp $sp 4
    lw $t7 4($t7)          # _init
    jalr $t7
>>

not(trueLabel, falseLabel, notLabel) ::= <<
    la $a0 <falseLabel>
    lw $t1 12($a0)     # bool slot
    la $a0 <trueLabel>
    beqz $t1 not_<notLabel>
    la $a0 <falseLabel>
not_<notLabel>:
>>

isvoid(trueLabel, falseLabel, label) ::= <<
    move $t1 $a0
    la $a0 <trueLabel>
    beqz $t1 isvoid_<label>
    la $a0 <falseLabel>
isvoid_<label>:
>>

lessOrMaybeEqual(e1, e2, trueLabel, falseLabel, label, op) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4
<e2>
    lw $t2 12($a0)
    lw $t1 4($sp)
    lw $t1 12($t1)
    addiu $sp $sp 4

    la $a0 <trueLabel>
    <op> $t1 $t2 less_<label>
    la $a0 <falseLabel>
less_<label>:
>>

equal(e1, e2, trueLabel, falseLabel, label) ::= <<
<e1>
    sw $a0 0($sp)
    addiu $sp $sp -4
<e2>
    move $t2 $a0
    lw $t1 4($sp)
    addiu $sp $sp 4

    la $a0 <trueLabel>
    la $a1 <falseLabel>
    jal equality_test
>>
